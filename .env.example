# Copy to .env.local for local development. Never commit real values (.env* files are ignored).
# Supabase is optional: without these the game runs on localStorage only (see docs/SUPABASE_SETUP.md).
# Only the public anon/publishable key belongs here — never a service-role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
